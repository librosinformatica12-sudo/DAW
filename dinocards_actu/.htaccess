# Sin listado de directorios (img/, styles/, ...)
Options -Indexes

# Archivos que nunca deben descargarse desde la web
<FilesMatch "\.(bat|sql|example|md|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
